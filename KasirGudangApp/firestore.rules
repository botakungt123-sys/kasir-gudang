rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function masuk() { return request.auth != null; }
    function owner(t) { return masuk() && request.auth.uid == t; }
    function anggota(t) {
      return masuk() && exists(/databases/$(database)/documents/toko/$(t)/anggota/$(request.auth.uid))
        && get(/databases/$(database)/documents/toko/$(t)/anggota/$(request.auth.uid)).data.aktif == true;
    }
    // Owner: akses penuh ke data tokonya sendiri.
    match /toko/{t}/{document=**} {
      allow read, write: if owner(t);
    }
    // Kasir aktif: stok tanpa HPP, menu berharga jadi, pesanan masuk, dan penjualan kasir.
    match /toko/{t}/stok/{id} { allow read: if anggota(t); }
    match /toko/{t}/publik/{id} { allow read: if anggota(t); }
    match /toko/{t}/pesanan/{id} {
      allow read: if anggota(t);
      allow update: if anggota(t) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'saleId', 'tsProses']);
    }
    match /toko/{t}/jual/{id} {
      allow read: if anggota(t);
      allow create: if anggota(t)
        && request.resource.data.kasirUid == request.auth.uid
        && request.resource.data.pemesan is string && request.resource.data.pemesan.size() > 0
        && request.resource.data.keys().hasAll(['ts', 'channel', 'items', 'sub'])
        && !request.resource.data.keys().hasAny(['hpp', 'net', 'fee', 'diproses', 'stokOk', 'batal', 'mintaBatal']);
      // Kasir hanya boleh mengajukan pembatalan penjualannya sendiri; owner yang memutuskan.
      allow update: if anggota(t) && resource.data.kasirUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mintaBatal']);
    }
    // Toko mitra (sesama akun milik owner): saling baca stok+HPP dan mengambil stok lewat dokumen transfer.
    function mitra(t) { return masuk() && exists(/databases/$(database)/documents/toko/$(t)/mitra/$(request.auth.uid)); }
    match /toko/{t}/stokMitra/{id} { allow read: if mitra(t); }
    match /toko/{t}/transfer/{id} {
      allow read: if mitra(t);
      allow create: if mitra(t) && request.resource.data.arah == 'keluar' && request.resource.data.status == 'baru'
        && request.resource.data.dari == t && request.resource.data.ke == request.auth.uid
        && request.resource.data.qty is number && request.resource.data.qty > 0;
    }
    match /toko/{t}/mitra/{u} {
      allow create: if masuk() && request.auth.uid == u
        && request.resource.data.keys().hasOnly(['kode', 'nama', 'email', 'ts'])
        && get(/databases/$(database)/documents/undanganMitra/$(request.resource.data.kode)).data.toko == t
        && get(/databases/$(database)/documents/undanganMitra/$(request.resource.data.kode)).data.dipakai == null
        && getAfter(/databases/$(database)/documents/undanganMitra/$(request.resource.data.kode)).data.dipakai == request.auth.uid;
    }
    match /undanganMitra/{k} {
      allow get: if masuk();
      allow create: if masuk() && request.resource.data.toko == request.auth.uid && request.resource.data.dipakai == null;
      allow delete: if masuk() && resource.data.toko == request.auth.uid;
      allow update: if masuk() && resource.data.dipakai == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dipakai'])
        && request.resource.data.dipakai == request.auth.uid
        && existsAfter(/databases/$(database)/documents/toko/$(resource.data.toko)/mitra/$(request.auth.uid));
    }
    // Tanda menu habis hari ini: owner dan kasir aktif.
    match /toko/{t}/habis/{id} { allow read, write: if anggota(t); }
    match /toko/{t}/anggota/{uid} {
      allow read: if masuk() && request.auth.uid == uid;
      // Kasir mendaftarkan diri hanya dengan kode undangan sekali pakai yang dibuat owner toko ini.
      allow create: if masuk() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nama', 'kode', 'aktif', 'ts'])
        && request.resource.data.aktif == true
        && request.resource.data.kode is string
        && get(/databases/$(database)/documents/undangan/$(request.resource.data.kode)).data.toko == t
        && get(/databases/$(database)/documents/undangan/$(request.resource.data.kode)).data.dipakai == null
        && getAfter(/databases/$(database)/documents/undangan/$(request.resource.data.kode)).data.dipakai == request.auth.uid
        && request.resource.data.nama == get(/databases/$(database)/documents/undangan/$(request.resource.data.kode)).data.nama;
    }
    // Akun kasir mencatat toko yang diikuti; hanya pemilik akun yang bisa membaca/menulis.
    match /akun/{uid} { allow read, write: if masuk() && request.auth.uid == uid; }
    // Kode kasir sekali pakai: dibuat owner; kasir hanya bisa menandainya terpakai bersamaan dengan mendaftar.
    match /undangan/{k} {
      allow get: if masuk();
      allow create: if masuk() && request.resource.data.toko == request.auth.uid && request.resource.data.dipakai == null;
      allow delete: if masuk() && resource.data.toko == request.auth.uid;
      allow update: if masuk() && (resource.data.toko == request.auth.uid
        || (resource.data.dipakai == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dipakai'])
            && request.resource.data.dipakai == request.auth.uid
            && existsAfter(/databases/$(database)/documents/toko/$(resource.data.toko)/anggota/$(request.auth.uid))));
    }
    // Kunci rahasia API per toko: tulis-saja, tidak bisa dibaca dari aplikasi.
    match /kunci/{uid}/platform/{plat} {
      allow create, update, delete: if masuk() && request.auth.uid == uid;
      allow read: if false;
    }
  }
}
